# Paths to the game data OpenT5 reads. Nothing here is ever written to.
# The disc's USRDIR/english folder: every base zone.
OPENT5_ZONES=/path/to/BLES01031/PS3_GAME/USRDIR/english
# The installed title update and DLC patch zones (dev_hdd0/game/BLES01031/USRDIR/english).
OPENT5_PATCH_ZONES=/path/to/dev_hdd0/game/BLES01031/USRDIR/english
# Optional: the console HDD's DLC zones. Searched recursively, so a root holding
# dlc1/english, dlc1/french, dlc2/... works as it is.
OPENT5_DLC_ZONES=
# The decrypted multiplayer executable, for loader research.
OPENT5_ELF=/path/to/t5mp.elf
# A folder holding online .wad files, for the optional wad tests.
OPENT5_WADS=
# Release signing key made by `npm run keygen` (outside the repo, e.g.
# ~/.opent5-release/opent5.key). Only tools/release.py reads it. Never commit the key.
OPENT5_RELEASE_KEY=/path/outside/the/repo/opent5.key
